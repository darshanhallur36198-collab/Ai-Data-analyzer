# ─── AI Data Analyzer — Environment Variables Template ────────────────────────
# Copy this file to backend/.env and replace placeholders with your actual keys.

# Required: Google Gemini API Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model identifier (Defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional: Production Frontend URL deployed on Vercel for CORS header matching
FRONTEND_URL=https://ai-data-analyzer.vercel.app
